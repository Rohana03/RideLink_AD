# Copy this file to .env at the repo root and fill in real values locally.
# NEVER commit the real .env file - it is already in .gitignore.

# Shared across all four services - must be identical everywhere so JWTs
# issued by Account Service verify correctly in the others.
JWT_SECRET=change-this-to-a-long-random-string-before-submission
JWT_EXPIRATION_MS=3600000

# Shared secret for service-to-service calls (Ride Management -> Driver & Vehicle)
INTERNAL_API_KEY=change-this-to-a-long-random-string-before-submission

# Optional bootstrap admin created by Account Service at start-up (ADMIN cannot self-register)
ADMIN_EMAIL=admin@ridelink.lk
ADMIN_PASSWORD=change-this-before-submission

# MongoDB (Account, Driver & Vehicle) - defaults point at a local server on port 27017
# MONGODB_URI=mongodb://localhost:27017/account_db

# MySQL connection, for any service that uses MySQL
DB_USER=root
DB_PASSWORD=root

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
