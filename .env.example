# Example configuration for all four services. Values here are placeholders only.
# Put real values in environment variables, or in each service's git-ignored
# src/main/resources/application-dev.yml, and run with the "dev" profile.

# --- Shared by every service -------------------------------------------------
# Must be identical everywhere: Account Service signs JWTs with it and the other
# three verify them locally. At least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000

# Shared key for service-to-service calls (header X-Internal-Api-Key).
# Ride Management -> Driver & Vehicle, Ride Management -> Fare & Payment.
INTERNAL_API_KEY=replace-with-another-random-string

# --- Databases (MongoDB, one database per service) ---------------------------
# Defaults already point at a local server; override only if yours differs.
# account-service         mongodb://localhost:27017/account_db
# driver-vehicle-service  mongodb://localhost:27017/driver_db
# ride-management-service mongodb://localhost:27017/ride_db
# fare-payment-service    mongodb://localhost:27017/fare_payment_db
MONGODB_URI=

# --- Account Service -----------------------------------------------------------
# Optional bootstrap admin created at start-up (ADMIN cannot self-register).
ADMIN_EMAIL=admin@ridelink.lk
ADMIN_PASSWORD=replace-with-an-admin-password

# --- Ride Management Service ---------------------------------------------------
DRIVER_SERVICE_URL=http://localhost:8082
FARE_SERVICE_URL=http://localhost:8084

# --- Optional RabbitMQ for the ride-completed event ----------------------------
# false (default): Ride reports completed rides to Fare over REST.
# true: Ride publishes RideCompletedEvent and Fare consumes it (needs RabbitMQ).
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
